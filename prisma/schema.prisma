generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

/// Hồ sơ người dùng - liên kết với Supabase Auth
model Profile {
  id           String        @id @default(uuid()) @db.Uuid
  fullName     String?       @map("full_name")
  phone        String?
  address      String?
  avatarUrl    String?       @map("avatar_url")
  role         UserRole      @default(customer)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rentalOrders RentalOrder[]
  reviews      Review[]

  @@map("profiles")
}

/// Danh mục style trang phục
model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?   @map("image_url")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  products    Product[]

  @@map("categories")
}

/// Sản phẩm trang phục cho thuê
model Product {
  id           String         @id @default(uuid()) @db.Uuid
  categoryId   String         @map("category_id") @db.Uuid
  name         String
  slug         String         @unique
  description  String?
  pricePerDay  Decimal        @map("price_per_day") @db.Decimal(10, 0)
  deposit      Decimal        @default(0) @db.Decimal(10, 0)
  sizes        String[]       @default([])
  color        String?
  quantity     Int            @default(1)
  status       ProductStatus  @default(available)
  thumbnailUrl String?        @map("thumbnail_url")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  images       ProductImage[]
  category     Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  rentalOrders RentalOrder[]
  reviews      Review[]

  @@map("products")
}

/// Ảnh sản phẩm (nhiều ảnh cho 1 sản phẩm)
model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  imageUrl  String   @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

/// Đơn đặt thuê trang phục
model RentalOrder {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  productId       String         @map("product_id") @db.Uuid
  selectedSize    String?        @map("selected_size")
  startDate       DateTime       @map("start_date") @db.Date
  endDate         DateTime       @map("end_date") @db.Date
  rentalDays      Int            @map("rental_days")
  totalPrice      Decimal        @map("total_price") @db.Decimal(10, 0)
  depositAmount   Decimal        @default(0) @map("deposit_amount") @db.Decimal(10, 0)
  extensionCount  Int            @default(0) @map("extension_count")
  originalEndDate DateTime?      @map("original_end_date") @db.Date
  extraFee        Decimal        @default(0) @map("extra_fee") @db.Decimal(10, 0)
  customerName    String         @map("customer_name")
  phone           String
  deliveryAddress String?        @map("delivery_address")
  deliveryMethod  DeliveryMethod @default(pickup) @map("delivery_method")
  note            String?
  status          OrderStatus    @default(pending)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  user            Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  extensions      OrderExtension[]
  review          Review?

  @@map("rental_orders")
}

/// Lịch sử gia hạn đơn hàng
model OrderExtension {
  id          String      @id @default(uuid()) @db.Uuid
  orderId     String      @map("order_id") @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  oldEndDate  DateTime    @map("old_end_date") @db.Date
  newEndDate  DateTime    @map("new_end_date") @db.Date
  extraDays   Int         @map("extra_days")
  extraAmount Decimal     @map("extra_amount") @db.Decimal(10, 0)
  status      String      @default("approved")
  note        String?
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  order       RentalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_extensions")
}

enum UserRole {
  customer
  admin
}

enum ProductStatus {
  available
  rented
  hidden
}

enum OrderStatus {
  pending
  confirmed
  renting
  completed
  cancelled
}

enum DeliveryMethod {
  pickup
  delivery
}

/// Đánh giá của khách hàng
model Review {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  orderId      String      @unique @map("order_id") @db.Uuid
  productId    String      @map("product_id") @db.Uuid
  customerName String      @map("customer_name")
  rating       Int         
  comment      String
  imageUrl     String?     @map("image_url")
  locationName String?     @map("location_name")
  isVisible    Boolean     @default(true) @map("is_visible")
  isFeatured   Boolean     @default(false) @map("is_featured")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  user         Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order        RentalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("reviews")
}
